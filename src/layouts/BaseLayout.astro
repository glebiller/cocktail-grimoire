---
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — Cocktail Grimoire` : 'Cocktail Grimoire';
const directionContract = `<!--
THESIS: Recipes live as chromatic glass specimens, not conventional image cards.
OWN-WORLD: Pale mineral ground, ink rules, cabinet bays, and translucent YAML accents.
STORY: Browse the numbered collection, choose a specimen, then read its complete supplied recipe.
FIRST VIEWPORT: A narrow masthead and title yield to a dense cabinet grid dominated by large glass marks.
FORM: The Chromatic Glass Cabinet, grounded direction 5, seed 753df929.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Fragment set:html={directionContract} />
    <slot />
  </body>
</html>
